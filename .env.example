# VITE_MOCKAPI_ORDERS_URL=https://6adbb59a3b7e90b820902734.mockapi.io/data/orders

# Admin login: typing the username below signs in with the configured email.
# Password is never stored in the frontend; create the account with
# `npm run create-admin` (needs SUPABASE_SERVICE_ROLE_KEY locally only).
